{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.ts?__route=/api/$1"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/server.ts?__route=/$1"
    }
  ],
  "functions": {
    "server.ts": {
      "includeFiles": "dist/**"
    }
  }
}
